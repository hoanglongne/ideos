{
  "name": "ideos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler d1 migrations apply ideos --local && wrangler dev --port 8787",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "preview:cf": "vite build && wrangler d1 migrations apply ideos --local && wrangler dev",
    "deploy": "vite build && wrangler d1 migrations apply ideos --remote && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.61.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.152.0"
  }
}
